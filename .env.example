# Copy to .env.local and fill in. Never commit .env.local.

# Public: safe to expose to the browser (protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL used to build auth email links (password reset). Never derived from the
# request Host header, so a spoofed host can't redirect reset links elsewhere.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Add only when a feature needs it (account deletion in P8.1).
# Never prefix with NEXT_PUBLIC_. Integration tests read it from .env.test.local.
# SUPABASE_SECRET_KEY=

# Supabase CLI database password (dev project). Do NOT put it here: create a gitignored
# .env.supabase.local containing SUPABASE_DB_PASSWORD=... ; scripts/supabase.mjs reads it.
